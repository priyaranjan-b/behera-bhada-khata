# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security - never expose to the browser.
# Called "service_role" key on older Supabase projects.
SUPABASE_SECRET_KEY=

# Required. The app's database connection (docs/design-decisions.md A19):
# every read and write goes through it; Supabase's keys above are for
# sign-in and file storage. Server-only.
# Where: Supabase -> Connect -> the "ORM" tab -> Drizzle (or "Shared pooler"
# / "Transaction pooler", depending on the dashboard version): the shared
# pooler in transaction mode, port 6543. Copy the host as shown
# (aws-<n>-<region>.pooler.supabase.com); it can't be derived from the region.
# Then change the user from postgres.<ref> to app_drizzle.<ref> (migrations
# 0027 and 0028, D32) and use its password, set once in the SQL editor with:
#   alter role app_drizzle password '<long random>';
# Not an API key: the pooler only accepts a database role and password.
# Percent-encode reserved characters in the password (& # ? @ / space).
# A secret like SUPABASE_SECRET_KEY: never NEXT_PUBLIC_ (startup refuses it).
# To rotate: run the alter role above again, then update it everywhere it's set.
# postgresql://app_drizzle.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Only for `npx drizzle-kit pull` (compare a database with the schema mirror).
# Never loaded by the app. Point it at a local or branch database, not at
# production with the postgres login.
# DRIZZLE_KIT_URL=

# Public base URL this app is deployed at, used to build tenant confirm links
# sent over WhatsApp/SMS, e.g. https://rent.example.com or your Vercel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Who may sign in. Comma-separated; listed owners may also create their
# account on first sign-in. Unset = only accounts that already exist.
OWNER_EMAILS=

# Local development only: "1" shows the sign-in link on screen instead of
# emailing it. Ignored when NODE_ENV=production.
# ALLOW_DEV_LOGIN=1

# Who sends the SMS codes for tenant sign-in and acknowledging (A34):
#   twilio    - Twilio Verify (TWILIO_ACCOUNT_SID / _AUTH_TOKEN / _VERIFY_SERVICE_SID below)
#   twofactor - 2Factor.in, an Indian provider at about Rs 0.16 per delivered code;
#               it registers the DLT OTP template for you (2factor.in -> API key)
OTP_PROVIDER=twilio
TWOFACTOR_API_KEY=
# The DLT-approved OTP template's name in the 2Factor dashboard; empty = its default template
TWOFACTOR_OTP_TEMPLATE=

# Twilio (twilio.com/console) - WhatsApp/SMS links, and SMS codes when OTP_PROVIDER=twilio.
# Optional, in production too: without it tenant messages show as "not delivered"
# and tenants can't acknowledge a receipt, but payments still count. The owner
# signs in with Supabase (password or email link) and never needs Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Verify service (for OTP) - console.twilio.com/us1/develop/verify/services
TWILIO_VERIFY_SERVICE_SID=
# A Twilio phone number (SMS) and WhatsApp-enabled sender, e.g. whatsapp:+14155238886
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Shared secret required in the `Authorization: Bearer <secret>` header when
# calling /api/cron/ensure-periods - set the same value on your Vercel Cron job.
# At least 16 characters; required in production (unset = the endpoint is locked).
CRON_SECRET=

# Optional - only when the API moves out of this app to a standalone backend.
# Server Components send their reads there (forwarding the session cookie)
# instead of calling src/server/services in-process.
# API_BASE_URL=https://api.example.com
# Browser-side equivalent for Client Components and API links (receipts).
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
